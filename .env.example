# Template for .env.local — copy and fill in:  cp .env.example .env.local
# Never commit .env.local.

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Allowlist of permitted sign-in emails (comma-separated)
AUTH_ALLOWED_EMAILS=

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Resend (Phase 6)
# AUTH_RESEND_KEY=
# AUTH_EMAIL_FROM=

# Strava (Phase 1)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Public base URL used by the strava:sub script to build the webhook callback.
# Set to your deployed origin (or ngrok https URL for local webhook testing).
APP_PUBLIC_URL=

# Inngest (Phase 1c)
# Required in production. Local dev uses the Inngest Dev Server and does not
# need these.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Sentry (Phase 6)
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
