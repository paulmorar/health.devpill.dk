# Template for .env.local — copy and fill in:  cp .env.example .env.local
# Never commit .env.local.

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Allowlist of permitted sign-in emails (comma-separated)
AUTH_ALLOWED_EMAILS=

# Neon Postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

